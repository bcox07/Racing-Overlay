<Window x:Class="RacingOverlay.TireWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RacingOverlay"
        mc:Ignorable="d"
        Title="TireWindow" Height="220" Width="140" Background="#00000000" Foreground="#D8000000" Opacity="0.85" WindowStyle="None" AllowsTransparency="True">
    <Grid x:Name="fuelGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="8*"></ColumnDefinition>
            <ColumnDefinition Width="1*"></ColumnDefinition>
            <ColumnDefinition Width="8*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="12*"></RowDefinition>
            <RowDefinition Height="1*"></RowDefinition>
            <RowDefinition Height="12*"></RowDefinition>
        </Grid.RowDefinitions>
        <Border x:Name="LFTempBorder" CornerRadius="15" Background="#FF32A229" Grid.Row="0" Grid.Column="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock x:Name="LFTemp" Text="100°" Foreground="#D8FFFFFF" TextAlignment="Center" VerticalAlignment="Center" Grid.Row="1" FontWeight="Bold"/>
                <TextBlock x:Name="LFWear" Text="100%" Foreground="#D8FFFFFF" TextAlignment="Center" VerticalAlignment="Center" Grid.Row="3" FontWeight="Bold"/>
            </Grid>
        </Border>
        <Border x:Name="LRTempBorder" CornerRadius="15" Background="#FF32A229" Grid.Row="2" Grid.Column="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock x:Name="LRTemp" Text="100°" Foreground="#D8FFFFFF" TextAlignment="Center" VerticalAlignment="Center" Grid.Row="1" FontWeight="Bold"/>
                <TextBlock x:Name="LRWear" Text="100%" Foreground="#D8FFFFFF" TextAlignment="Center" VerticalAlignment="Center" Grid.Row="3" FontWeight="Bold"/>
            </Grid>
        </Border>
        <Border x:Name="RFTempBorder" CornerRadius="15" Background="#FF32A229" Grid.Row="0" Grid.Column="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock x:Name="RFTemp" Text="100°" Foreground="#D8FFFFFF" TextAlignment="Center" VerticalAlignment="Center" Grid.Row="1" FontWeight="Bold"/>
                <TextBlock x:Name="RFWear" Text="100%" Foreground="#D8FFFFFF" TextAlignment="Center" VerticalAlignment="Center" Grid.Row="3" FontWeight="Bold"/>
            </Grid>
        </Border>
        <Border x:Name="RRTempBorder" CornerRadius="15" Background="#FF32A229" Grid.Row="2" Grid.Column="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock x:Name="RRTemp" Text="100°" Foreground="#D8FFFFFF" FontSize="13" TextAlignment="Center" VerticalAlignment="Center" Grid.Row="1" FontWeight="Bold"/>
                <TextBlock x:Name="RRWear" Text="100%" Background="Transparent" Foreground="#D8FFFFFF" FontSize="13" TextAlignment="Center" VerticalAlignment="Center" Grid.Row="3" FontWeight="Bold"/>
            </Grid>
        </Border>
        
        
        
        
    </Grid>
</Window>
